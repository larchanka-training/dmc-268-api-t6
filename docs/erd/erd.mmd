    WORKSPACES {
      uuid id PK
      varchar name
      numeric daily_budget_usd
    }
    PROVIDER_INSTALLATIONS {
      uuid id PK
      uuid workspace_id FK
      varchar provider
      bigint external_id
      jsonb metadata
    }
    REPOSITORIES {
      uuid id PK
      uuid provider_installation_id FK
      bigint external_id
      uuid prompt_version_id FK
      enum default_engine
      boolean enabled
      boolean rag_enabled
    }
    CODE_CHANGES {
      uuid id PK
      uuid repository_id FK
      bigint external_id
      int external_number
      varchar base_sha
      varchar head_sha
      enum state
    }
    RUNS {
      uuid id PK
      uuid code_change_id FK
      uuid rule_version_id FK
      uuid prompt_version_id FK
      uuid conventions_prompt_version_id FK
      uuid verifier_prompt_version_id FK
      char idempotency_key UK
      enum state
      enum engine
      int attempt
      boolean cancel_requested
      varchar error_code
      timestamptz started_at
      timestamptz finished_at
      timestamptz available_at
      enum severity_threshold
      smallint max_comments
    }
    CONTEXT_PAYLOADS {
      uuid id PK
      uuid run_id FK
      int schema_version
      jsonb summary
      text s3_ref
    }
    FINDINGS {
      uuid id PK
      uuid run_id FK
      varchar file_path
      int line_start
      enum side
      enum severity
      enum category
      text suggestion
      numeric confidence
      boolean published
    }
    COMMENTS {
      uuid id PK
      uuid finding_id FK
      bigint github_review_id
      bigint github_comment_id UK
    }
    RULE_VERSIONS {
      uuid id PK
      uuid repository_id FK
      int version
      jsonb rules
      char checksum
      boolean is_active
    }
    PROMPT_VERSIONS {
      uuid id PK
      varchar key
      int version
      text content
      char checksum
      boolean is_active
    }
    WEBHOOK_EVENTS {
      uuid id PK
      uuid provider_installation_id FK
      varchar delivery_id UK
      text payload_s3_ref
    }
    USAGE_EVENTS {
      uuid id PK
      uuid run_id FK
      uuid workspace_id FK
      varchar model
      numeric cost_usd
      timestamptz created_at
    }
    PAYMENTS {
      uuid id PK
      uuid workspace_id FK
      varchar provider
      enum status
      numeric amount_usd
    }
    CREDIT_LEDGER {
      uuid id PK
      uuid workspace_id FK
      uuid usage_event_id FK
      uuid payment_id FK
      enum kind
      numeric amount_usd
    }
    REPO_CONVENTIONS {
      uuid id PK
      uuid repository_id FK
      uuid prompt_version_id FK
      varchar agents_md_sha
      char policy_key
      text agents_md
      jsonb key_patterns
      jsonb recommendations
      jsonb languages
    }
    RUN_ACTIONS {
      uuid id PK
      uuid run_id FK
      int index
      varchar tool
      jsonb request
      jsonb response
      text response_ref
      timestamptz started_at
      int duration_ms
    }
    RUN_POLICY_DOCUMENTS {
      uuid id PK
      uuid run_id FK
      varchar path
      varchar presence
      varchar blob_oid
      char text_sha256
      text text
    }
    RUN_POLICY_SNAPSHOTS {
      uuid run_id PK, FK
      uuid snapshot_id UK
      uuid repository_id FK
      uuid service_defaults_rule_version_id FK
      int schema_version
      varchar policy_base_sha
      char ignore_digest
      char defaults_checksum
      jsonb prompt_bindings
      jsonb execution_profile
      char policy_digest
      enum severity_threshold
      smallint max_comments
    }
    CONTEXT_MANIFESTS {
      uuid id PK
      uuid run_id FK
      int attempt
      uuid call_id UK
      varchar stage
      varchar recovery_kind
      uuid parent_call_id
      uuid policy_snapshot_id FK
      char digest
      int input_tokens
      jsonb blocks
    }
    CODE_INDEX_STATES {
      uuid repository_id PK, FK
      bigint generation
      bigint reserved_publication
      bigint published_publication
      bigint floor_publication
      enum status
      enum purge_reason
      varchar error_code
      varchar last_error_code
      varchar indexed_commit_sha
      varchar target_commit_sha
      uuid lease_token
      timestamptz lease_expires_at
      timestamptz published_at
      timestamptz last_used_at
      timestamptz wake_requested_at
      timestamptz review_full_requested_at
      varchar review_full_requested_sha
      int file_count
      int symbol_count
      int edge_count
    }
    REPOSITORY_RULES_STATUS {
      uuid repository_id PK, FK
      varchar status
      varchar branch
      varchar sha
      text text
      char checksum
      jsonb ignore_masks
      jsonb diagnostics
      varchar defaults_version
      timestamptz checked_at
      timestamptz refresh_requested_at
      timestamptz refresh_claimed_until
    }
    CODE_INDEX_FILES {
      uuid repository_id PK, FK
      bigint generation PK
      bigint valid_from PK
      bigint valid_to
      varchar path PK
      varchar blob_sha
    }
    CODE_INDEX_SYMBOLS {
      uuid repository_id PK, FK
      bigint generation PK
      bigint valid_from PK
      bigint valid_to
      varchar path PK
      varchar qualified_name PK
      enum kind PK
      int disambiguator PK
      int start_line
      int end_line
    }
    CODE_INDEX_EDGES {
      uuid repository_id PK, FK
      bigint generation PK
      bigint valid_from PK
      bigint valid_to
      varchar path PK
      enum kind PK
      varchar target_path PK
      varchar target_name PK
    }
    CODE_INDEX_IMPORTS {
      uuid repository_id PK, FK
      bigint generation PK
      bigint valid_from PK
      bigint valid_to
      varchar path PK
      varchar specifier PK
      enum resolution PK
      varchar target_path
    }
