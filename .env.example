POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app

# GitHub installation webhook. The private key is the GitHub App PEM value;
# keep it only in the deployment secret store, never in git.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Bot login `<app-slug>[bot]`, dev App: dmc268-t6-reviewer-dev[bot]. Configure
# all three GitHub App values together for GitHub webhook replay; GitLab-only replay
# can omit all three. The staging App login breaks Р-9, SD §8.3 in local dev.
GITHUB_APP_BOT_LOGIN=
# GitHub App user OAuth credentials; client ID differs from GITHUB_APP_ID.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# RS256 local access JWT keypair and fixed verification identifiers.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_ISSUER=dmc-268-api
AUTH_JWT_AUDIENCE=dmc-268-ui
# GITHUB_API_URL=https://api.github.com

# Backend
BACKEND_PORT=8000

# RabbitMQ: review queue broker (docker-compose service `rabbitmq`). The API process
# (reconciler, rerun, cancel close signal), the webhook worker (Runs from deliveries,
# required) and the review worker (`python -m app.worker`) connect with RABBITMQ_URL; without it the API skips these publications and the
# worker does not start.
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app
RABBITMQ_URL=amqp://app:app@rabbitmq:5672/
# Worker: optional stable id (defaults to hostname:pid) and PORTAL_URL for run links.
# Without GITHUB_APP_ID / GITHUB_APP_PRIVATE_KEY the worker still starts, but the no-CI
# sweep, GitHub publication and the index consumer are disabled.
WORKER_ID=
PORTAL_URL=

# Optional installed GitLab runtime; keep this WHOLE block commented for GitHub-only
# startup. Provision real values through a protected process environment/secret manager.
# Staging CI maps secret GITLAB_CREDENTIAL_KEYS and same-named variables for the other
# GITLAB_* entries below into owner-only gitlab.env (both workers + operator profile).
# Only GITLAB_WEBHOOK_INTAKE_ENABLED goes to api.env. See docs/SECRETS.md for setup.
# GitHub secret/variable UI takes raw JSON, without the shell quotes shown below.
# Generate each key with `openssl rand -base64 32` into protected storage; do not paste
# keys or tokens into shell arguments, chat, logs or Git. Replace the illustrative
# base64 placeholder below with canonical standard-base64 encoding of exactly 32 bytes.
# GITLAB_CREDENTIAL_KEYS='{"key-2026-10":"<base64-of-32-random-bytes>"}'
# GITLAB_ACTIVE_KEY_ID=key-2026-10
# GITLAB_ALLOWED_ORIGINS='["https://gitlab.com"]'
# GITLAB_PRIVATE_ORIGINS='[]'
# Private-network origins require their exact canonical HTTPS origin in BOTH
# arrays; a private project on gitlab.com does not require PRIVATE_ORIGINS.
# Optional PRIVATE_ORIGINS defaults to []; with complete core, empty text is
# invalid while JSON [] is valid. PRIVATE_ORIGINS=[] alone is a partial-config error.
# Any nonempty core/private setting opts replay and review workers into validation;
# all three core settings are required. SSL_CERT_FILE alone does not opt in.
# SSL_CERT_FILE=/protected/gitlab-ca-bundle.pem
# SSL_CERT_FILE is local-process-only here: staging does not bundle/mount custom CA
# files. Custom trust needs separately reviewed mounted-CA wiring; keep TLS checks.
# API admission is separate, default off, and needs no keyring or provider token.
# Deployment preflight requires complete valid worker config when intake is true.
# Initially provision complete runtime with false, onboard the connection, then
# selectively activate it and enable API admission in the authorized environment:
# GITLAB_WEBHOOK_INTAKE_ENABLED=false
# The API parser strips whitespace and ignores case; only true, false or empty are
# accepted (empty/unset=false). 1/0/yes/no are invalid. Per-connection activation is
# also required: docs/SECRETS.md. Legacy GITLAB_TOKEN/BASE_URL supply no authority.
# Heartbeat file of worker and webhook-worker for a container healthcheck without an HTTP
# port (app/common/infrastructure/heartbeat.py); both compose files set it, outside Compose
# it stays unset.
# WORKER_HEARTBEAT_FILE=/tmp/worker.heartbeat

# Redis: cache only (SD §10, docker-compose service `redis`). The review worker and the
# webhook worker read REDIS_URL: GitHub installation tokens shared by both (#62), and in
# the review worker AST facts and file trees of the context stage (#130). Without it, or
# when Redis is unreachable, tokens stay in each process and the stage works without the
# cache. The local Redis has no password; staging generates REDIS_PASSWORD on the host
# (docs/SECRETS.md).
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# LLM gateway (#33; docs/SECRETS.md). Keys are a comma-separated list, rotated on
# 401/403/429; never log them. Known models (mistral-small-4, mistral-small-3.2-24b)
# carry their EUrouter base URL, window and prices; set the other LLM_* only to override.
LLM_MODEL=
LLM_API_KEYS=
# LLM_PROVIDER=eurouter
# LLM_BASE_URL=https://api.eurouter.ai/api/v1
# LLM_CONTEXT_WINDOW=
# LLM_MAX_OUTPUT_TOKENS=
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
# LLM_PRICE_CACHE_READ_PER_MTOK=
# LLM_STRUCTURED_OUTPUT=json_schema
# LLM_EXTRA_BODY=
# Fallback model. A known model keeps its own endpoint; keys are inherited only when the
# fallback uses the primary's base URL, never sent to another host. The same overrides
# as above exist with the LLM_FALLBACK_ prefix (_PROVIDER, _CONTEXT_WINDOW,
# _MAX_OUTPUT_TOKENS, _PRICE_*_PER_MTOK, _STRUCTURED_OUTPUT, _EXTRA_BODY).
# A remote model without LLM_PRICE_* is priced 0: the run cost limit then sees only
# the provider's usage.cost.
LLM_FALLBACK_MODEL=
# LLM_FALLBACK_API_KEYS=
# LLM_FALLBACK_BASE_URL=
# Verifier pair, default LLM_MODEL / LLM_FALLBACK_MODEL; the same overrides with these prefixes.
# LLM_VERIFIER_MODEL=
# LLM_VERIFIER_FALLBACK_MODEL=
# Self-hosted dev/eval only (LM Studio, Ollama, vLLM), never on staging or prod:
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_STRUCTURED_OUTPUT=prompt_json
# LLM_ALLOW_PROMPT_JSON=1

# Graph index (#142, SD §7.4): the worker also consumes index.repo. Every variable is
# optional, the defaults below live in code, and an invalid value fails the worker start:
# DEADLINE at most 1500 (below RabbitMQ's consumer_timeout), LEASE at least DEADLINE + 60
# and at most 86400, SOFT_CUTOFF below DEADLINE. Without the GitHub App the consumer is
# off. They reach a worker started with
# `uv run --env-file .env`; the docker compose worker has a fixed environment: list, so a
# value there needs an entry in it, and on staging only under environment: in
# deploy/compose/staging.yml (worker.env comes from the allowlist of env-file.sh).
# CODE_INDEX_MAX_CONCURRENT=2
# CODE_INDEX_MAX_CONCURRENT_PER_INSTALLATION=1
# CODE_INDEX_DEADLINE_SECONDS=900
# CODE_INDEX_LEASE_SECONDS=1200
# CODE_INDEX_SOFT_CUTOFF_SECONDS=300
# CODE_INDEX_DISCARD_BATCH_ROWS=10000
# CODE_INDEX_MAX_DOWNLOAD_BYTES=104857600
# CODE_INDEX_MAX_UNPACKED_BYTES=1073741824
# CODE_INDEX_MAX_ARCHIVE_ENTRIES=100000
# CODE_INDEX_MAX_FILE_BYTES=1048576
# CODE_INDEX_MAX_PARSED_FILES=20000
# CODE_INDEX_MAX_SYMBOLS=500000
# CODE_INDEX_MAX_EDGES=2000000
# CODE_INDEX_MAX_INCREMENTAL_FILES=500
# CODE_INDEX_MAX_REPOSITORY_STORAGE_BYTES=536870912
# CODE_INDEX_MAX_WORKSPACE_STORAGE_BYTES=2147483648
# The worker leader's converge pass, TTL purge and garbage collection of the graph index
# (#143, SD §10) run with or without the GitHub App. TTL_DAYS is 1 to 3650, TTL_INTERVAL
# at most 86400, GC_INTERVAL at most 1800 and GC_BATCH_ROWS at most 100000. GC runs every
# interval and keeps running on consecutive leader ticks until drained; the target is
# physical deletion of a purged index's rows within an hour.
# CODE_INDEX_TTL_DAYS=30
# CODE_INDEX_TTL_INTERVAL_SECONDS=3600
# CODE_INDEX_GC_INTERVAL_SECONDS=300
# CODE_INDEX_GC_BATCH_ROWS=10000
# The leader's reconcile with the default-branch head and its wake-up dispatch need the
# GitHub App. Every RECONCILE_INTERVAL seconds the reconcile compares up to RECONCILE_BATCH
# live indexes per tick with their head, until it has gone through all of them;
# RECONCILE_INTERVAL is at most 86400 and RECONCILE_BATCH at most 500.
# CODE_INDEX_RECONCILE_INTERVAL_SECONDS=600
# CODE_INDEX_RECONCILE_BATCH=50
