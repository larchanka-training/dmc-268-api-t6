POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app

# GitHub installation webhook. The private key is the GitHub App PEM value;
# keep it only in the deployment secret store, never in git.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_BOT_LOGIN=
# GitHub App user OAuth credentials; client ID differs from GITHUB_APP_ID.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# RS256 local access JWT keypair and fixed verification identifiers.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_ISSUER=dmc-268-api
AUTH_JWT_AUDIENCE=dmc-268-ui
# GITHUB_API_URL=https://api.github.com

# RabbitMQ credentials used by Compose; the worker encodes these in its broker URL.
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app
# Set RABBITMQ_URL explicitly for an external broker or a worker outside Compose.
# RABBITMQ_URL=amqp://app:app@rabbitmq:5672/

# Backend
BACKEND_PORT=8000
