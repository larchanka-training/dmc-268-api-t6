POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app

# GitHub installation webhook. The private key is the GitHub App PEM value;
# keep it only in the deployment secret store, never in git.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_BOT_LOGIN=
# GitHub App user OAuth credentials; client ID differs from GITHUB_APP_ID.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# RS256 local access JWT keypair and fixed verification identifiers.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_ISSUER=dmc-268-api
AUTH_JWT_AUDIENCE=dmc-268-ui
# GITHUB_API_URL=https://api.github.com

# Backend
BACKEND_PORT=8000

# RabbitMQ: review queue broker (docker-compose service `rabbitmq`). The API process
# (reconciler, rerun, cancel close signal) and the worker (`python -m app.worker`)
# connect with RABBITMQ_URL; without it the API skips these publications and the
# worker does not start.
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app
RABBITMQ_URL=amqp://app:app@rabbitmq:5672/
# Worker: optional stable id (defaults to hostname:pid) and the portal URL used for
# run links in check-runs. Without GITHUB_APP_ID / GITHUB_APP_PRIVATE_KEY the worker
# still starts, but the no-CI sweep and GitHub publication are disabled.
WORKER_ID=
PORTAL_URL=

# LLM gateway (#33; docs/SECRETS.md). Keys are a comma-separated list, rotated on
# 401/403/429; never log them. Known models (gpt-4.1-mini, mistral-small-4) carry
# their EUrouter base URL, window and prices; set the other LLM_* only to override.
LLM_MODEL=
LLM_API_KEYS=
# LLM_PROVIDER=eurouter
# LLM_BASE_URL=https://api.eurouter.ai/api/v1
# LLM_CONTEXT_WINDOW=
# LLM_MAX_OUTPUT_TOKENS=
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
# LLM_PRICE_CACHE_READ_PER_MTOK=
# LLM_STRUCTURED_OUTPUT=json_schema
# LLM_EXTRA_BODY=
# Fallback model: unset LLM_FALLBACK_* inherit provider, base URL and keys.
LLM_FALLBACK_MODEL=
# LLM_FALLBACK_API_KEYS=
# LLM_FALLBACK_BASE_URL=
# Self-hosted dev/eval only (LM Studio, Ollama, vLLM), never on staging or prod:
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_STRUCTURED_OUTPUT=prompt_json
# LLM_ALLOW_PROMPT_JSON=1
