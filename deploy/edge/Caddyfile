{
	# With handle_errors on any site Caddy logs proxy errors (the cause of a 502: no such host,
	# connection refused) at debug level for every site. This log keeps them visible.
	log proxy_errors {
		include http.log.error
		level DEBUG
	}
}

# Edge routes on the shared course VPS, one hostname per service and environment under
# APP_DOMAIN. Certificates come from Let's Encrypt; HTTP redirects to HTTPS automatically.
# Upstreams are aliases on the docker network dmc268-edge. When an upstream is not running, Caddy
# itself still starts and serves the other routes: staging-api and staging-ui answer a bare 502;
# api, ui, webhook and staging-webhook answer 503 with the not_deployed stub below.

(hsts) {
	header Strict-Transport-Security "max-age=31536000"
}

# Hosts whose service is not deployed yet (prod, the standalone webhook service) answer 503 with a
# plain text instead of a bare 502. handle_errors runs whenever Caddy cannot reach the upstream:
# before the first rollout and, after it, while the service is down or restarting. The text speaks
# of the service behind the address, not of the host: on ui.* the API can be down behind a running
# UI. The routes below are already final, so a rollout needs no Caddyfile change.
(not_deployed) {
	handle_errors 502 {
		import hsts
		respond "The service behind this address is not running or is restarting." 503
	}
}

staging-api.{$APP_DOMAIN} {
	import hsts
	reverse_proxy api-staging:8000
}

api.{$APP_DOMAIN} {
	import hsts
	import not_deployed
	reverse_proxy api-prod:8000
}

staging-webhook.{$APP_DOMAIN} {
	import hsts
	import not_deployed
	reverse_proxy webhook-staging:8000
}

webhook.{$APP_DOMAIN} {
	import hsts
	import not_deployed
	reverse_proxy webhook-prod:8000
}

# One origin (#20): /api/* on the UI host, /api/auth/* and the SSE /api/stream included, goes to
# the API, so the UI needs no CORS and the refresh cookie (Path=/api/auth) reaches the API.
# Caddy flushes text/event-stream responses immediately. staging-api keeps healthcheck and webhooks.
staging-ui.{$APP_DOMAIN} {
	import hsts
	handle /api/* {
		reverse_proxy api-staging:8000
	}
	handle {
		reverse_proxy ui-staging:8080
	}
}

# The same one origin for prod.
ui.{$APP_DOMAIN} {
	import hsts
	import not_deployed
	handle /api/* {
		reverse_proxy api-prod:8000
	}
	handle {
		reverse_proxy ui-prod:8080
	}
}

{$APP_DOMAIN} {
	import hsts
	redir https://ui.{$APP_DOMAIN}{uri} permanent
}
