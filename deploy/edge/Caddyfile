{
	# With handle_errors on any site Caddy logs proxy errors (the cause of a 502: no such host,
	# connection refused) at debug level for every site. This log keeps them visible.
	log proxy_errors {
		include http.log.error
		level DEBUG
	}
	# Request metrics for the monitoring stack (deploy/monitoring): RPS, status codes and latency
	# per site address. per_host adds the host label, so staging and prod stay apart.
	metrics {
		per_host
	}
}

# Prometheus endpoint for the monitoring stack, plain HTTP on the edge network only: no host port
# publishes 9180 (deploy/edge/compose.yml), and the Caddy admin API stays on localhost.
http://:9180 {
	metrics /metrics
}

# Edge routes on the shared course VPS, one hostname per service and environment under
# APP_DOMAIN. Certificates come from Let's Encrypt; HTTP redirects to HTTPS automatically.
# Upstreams are aliases on the docker network dmc268-edge. When an upstream is not running, Caddy
# itself still starts and serves the other routes: staging-api and staging-ui answer a bare 502;
# api, ui, webhook, staging-webhook and the landing hosts (APP_DOMAIN, www, staging,
# staging-www) answer 503 with the not_deployed stub below.

(hsts) {
	header Strict-Transport-Security "max-age=31536000"
}

# Hosts whose service is not deployed yet (prod, the standalone webhook service) and the landing
# hosts (routed before the UI repo's first landing rollout) answer 503 with a plain text instead
# of a bare 502. handle_errors runs whenever Caddy cannot reach the upstream: before the first
# rollout and, after it, while the service is down or restarting. The text speaks of the service
# behind the address, not of the host: on ui.* the API can be down behind a running UI. The routes
# below are already final, so a rollout needs no Caddyfile change; only APP_DOMAIN and www move
# to landing-prod:8080 and docs-prod:8080 once the prod landing and docs exist.
(not_deployed) {
	handle_errors 502 {
		import hsts
		respond "The service behind this address is not running or is restarting." 503
	}
}

staging-api.{$APP_DOMAIN} {
	import hsts
	reverse_proxy api-staging:8000
}

# Grafana of the monitoring stack (deploy/monitoring, docs/MONITORING.md) with its own login.
# The names prometheus.* and victoria-metrics.* also point here but get no site: Prometheus has
# no authentication and stays on the docker networks, VictoriaMetrics is not used.
grafana.{$APP_DOMAIN} {
	import hsts
	# Grafana serves /metrics without login (Prometheus scrapes it inside the docker network): its
	# version, plugins and login counters stay off the internet.
	@metrics path /metrics /metrics/*
	handle @metrics {
		respond 404
	}
	handle {
		reverse_proxy grafana-staging:3000
	}
}

# Public status page of the monitoring stack (api#309): prod and staging on status.*, staging only on
# staging-status.* (the service tells them apart by the Host it is handed). Only GET and HEAD of "/"
# reach it; every other path is answered here, so no path of Prometheus, Alertmanager or Grafana
# is routed, whatever the upstream would say to it. The service is rolled out by the monitoring
# deploy, this route by the staging deploy: in between the route answers a bare 502.
status.{$APP_DOMAIN}, staging-status.{$APP_DOMAIN} {
	import hsts
	@page {
		path /
		method GET HEAD
	}
	handle @page {
		reverse_proxy status-staging:8080
	}
	handle {
		respond 404
	}
}

api.{$APP_DOMAIN} {
	import hsts
	import not_deployed
	reverse_proxy api-prod:8000
}

staging-webhook.{$APP_DOMAIN} {
	import hsts
	import not_deployed
	reverse_proxy webhook-staging:8000
}

webhook.{$APP_DOMAIN} {
	import hsts
	import not_deployed
	reverse_proxy webhook-prod:8000
}

# One origin (#20): /api/* on the UI host, /api/auth/* and the SSE /api/stream included, goes to
# the API, so the UI needs no CORS and the refresh cookie (Path=/api/auth) reaches the API.
# Caddy flushes text/event-stream responses immediately. staging-api keeps healthcheck and webhooks.
staging-ui.{$APP_DOMAIN} {
	import hsts
	handle /api/* {
		reverse_proxy api-staging:8000
	}
	handle {
		reverse_proxy ui-staging:8080
	}
}

# The same one origin for prod.
ui.{$APP_DOMAIN} {
	import hsts
	import not_deployed
	handle /api/* {
		reverse_proxy api-prod:8000
	}
	handle {
		reverse_proxy ui-prod:8080
	}
}

# Public landing (larchanka-training/dmc-268-ui-t6#91) and its user docs (#173), both deployed by
# the UI repo: /docs and /docs/* go to docs-staging (the docs are built with basePath /docs, so
# the path goes through unchanged), everything else to landing-staging. Both are static: no /api/*
# route.
staging.{$APP_DOMAIN}, staging-www.{$APP_DOMAIN} {
	import hsts
	import not_deployed
	@docs path /docs /docs/*
	handle @docs {
		reverse_proxy docs-staging:8080
	}
	handle {
		reverse_proxy landing-staging:8080
	}
}

# The main domain shows the staging landing and docs until a prod rollout exists; then these two
# hosts move to landing-prod:8080 and docs-prod:8080. Both sites are static, with no backend and
# no data, and their links go to staging-ui (the "Заглушка" paragraph of docs/CICD.md §8.2).
{$APP_DOMAIN}, www.{$APP_DOMAIN} {
	import hsts
	import not_deployed
	@docs path /docs /docs/*
	handle @docs {
		reverse_proxy docs-staging:8080
	}
	handle {
		reverse_proxy landing-staging:8080
	}
}
