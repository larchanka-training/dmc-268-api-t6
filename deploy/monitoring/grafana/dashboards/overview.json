    {
      "type": "timeseries",
      "title": "Phase duration p95",
      "description": "95th percentile per trace tool (docs/PIPELINE_SPEC.md §2): diff, context, LLM, post-processing, publication.",
      "id": 11,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroupAlias(started_at, '15m'),\n  tool AS metric,\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms) / 1000.0 AS value\nFROM run_actions\nWHERE $__timeFilter(started_at)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
