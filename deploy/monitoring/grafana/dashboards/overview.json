    {
      "type": "timeseries",
      "title": "LLM call latency",
      "description": "Duration of every LLM provider call (run_actions, tool llm.call) in 5-minute buckets.",
      "id": 6,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroupAlias(started_at, '5m'),\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms) / 1000.0 AS \"p50\",\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms) / 1000.0 AS \"p95\",\n  max(duration_ms) / 1000.0 AS \"max\"\nFROM run_actions\nWHERE tool = 'llm.call' AND $__timeFilter(started_at)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      }
    },
