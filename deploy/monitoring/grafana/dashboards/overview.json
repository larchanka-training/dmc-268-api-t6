    {
      "type": "table",
      "title": "Phases over the range",
      "description": "Calls and durations of each trace tool in the dashboard range.",
      "id": 12,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT\n  tool AS \"Phase\",\n  count(*) AS \"Calls\",\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms) / 1000.0 AS \"p50\",\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms) / 1000.0 AS \"p95\",\n  max(duration_ms) / 1000.0 AS \"Max\"\nFROM run_actions\nWHERE $__timeFilter(started_at)\nGROUP BY tool\nORDER BY \"p95\" DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "p50|p95|Max"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 22
      }
    },
