@@ -1,6 +1,13 @@
 import { totalCents } from "./bookings";
+import { toCents } from "./money";
 import type { Booking } from "./types";
 
 export function balanceCents(booking: Booking, paidCents: number): number {
   return totalCents(booking) - paidCents;
 }
+
+export function depositCents(booking: Booking, percent: number): number {
+  const share = totalCents(booking) * (percent / 100);
+  const rounded = Math.round(share);
+  return toCents(rounded);
+}
