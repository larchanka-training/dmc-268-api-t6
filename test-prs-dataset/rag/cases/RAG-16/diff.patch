+import { paginate } from "./paging";
 import type { Row } from "./types";
 
 export const PAGE_SIZE = 25;
@@ -5,3 +6,11 @@ export const PAGE_SIZE = 25;
 export function matching(rows: Row[], term: string): Row[] {
   return rows.filter((row) => row.title.includes(term));
 }
+
+export function pageAtOffset(rows: Row[], offset: number): Row[] {
+  if (offset < 0) {
+    throw new RangeError("offset must not be negative");
+  }
+  const page = Math.floor(offset / PAGE_SIZE);
+  return paginate(rows, page, PAGE_SIZE);
+}
