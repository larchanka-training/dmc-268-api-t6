+def open_slots(day: date) -> dict[str, list[Slot]]:
+    """Return the free slots of the day, grouped by doctor."""
+    by_doctor: dict[str, list[Slot]] = {}
+    for slot in _SLOTS:
+        if slot.day == day and not slot.taken:
+            by_doctor.setdefault(slot.doctor, []).append(slot)
+    return by_doctor
