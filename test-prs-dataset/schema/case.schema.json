{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gold benchmark case",
  "description": "Input and ground truth for one PR case. Recorded model responses and their model/prompt provenance belong in a separate response manifest.",
  "type": "object",
  "required": ["id", "class", "language", "source", "base_path", "patch_path", "expected_verdict", "expected_findings"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^(SEC|RES|LOG|SYN|CLEAN|RUL|RAG)-[0-9]{2}$" },
    "class": { "enum": ["security", "resource", "logic", "syntax", "clean", "rules", "rag"] },
    "category_reason": { "type": "string", "minLength": 1 },
    "language": { "enum": ["python", "typescript", "tsx"] },
    "source": {
      "type": "object",
      "required": ["kind", "attribution"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["synthetic", "real"] },
        "url": { "type": "string", "pattern": "^https://", "minLength": 9 },
        "revision": { "type": "string", "minLength": 1 },
        "license_name": { "type": "string", "minLength": 1 },
        "license_url": { "type": "string", "pattern": "^https://", "minLength": 9 },
        "attribution": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "kind": { "const": "real" } } },
      "then": { "required": ["url", "revision", "license_name", "license_url", "attribution"] }
    },
    "base_path": { "type": "string", "minLength": 1 },
    "apply_directory": { "type": "string", "minLength": 1 },
    "patch_path": { "type": "string", "pattern": "\\.patch$", "minLength": 7 },
    "expected_verdict": {
      "description": "Derived from all expected findings; with policy arms it is the union over the arms, and scoring derives each arm's verdict from that arm's findings.",
      "enum": ["blocking", "attention", "clean"]
    },
    "expected_findings": { "type": "array", "items": { "$ref": "#/$defs/groundTruthFinding" } },
    "policy": {
      "description": "Policy arms of a rules case: repository rules documents under base_path. Arm none has no document; valid is the file at .review/rules.md.",
      "type": "object",
      "required": ["arms"],
      "additionalProperties": false,
      "properties": {
        "arms": {
          "type": "object",
          "required": ["valid", "malicious"],
          "additionalProperties": false,
          "properties": {
            "valid": { "type": "string", "minLength": 1 },
            "malicious": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "rag": {
      "description": "Graph-RAG contribution case of the #146 sub-corpus: what each arm shows and why the defect needs the retrieved callers.",
      "$ref": "#/$defs/rag"
    },
    "must_not_flag": {
      "description": "Exception anchors: in a listed arm, a prediction on the same path within two lines of one (category ignored) that no truth matched is an exception violation.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/exceptionAnchor" }
    }
  },
  "allOf": [{
    "if": { "properties": { "class": { "const": "clean" } } },
    "then": { "properties": { "expected_findings": { "maxItems": 0 } } },
    "else": {
      "if": { "properties": { "class": { "const": "rag" } } },
      "then": {
        "allOf": [{
          "description": "Only a clean RAG case has no truth; a reverse-edge or injection case has exactly one.",
          "if": { "required": ["rag"], "properties": { "rag": { "required": ["kind"], "properties": { "kind": { "const": "clean" } } } } },
          "then": { "properties": { "expected_findings": { "maxItems": 0 } } },
          "else": { "properties": { "expected_findings": { "minItems": 1 } } }
        }, {
          "if": { "required": ["rag"], "properties": { "rag": { "required": ["kind"], "properties": { "kind": { "enum": ["reverse_edge", "injection"] } } } } },
          "then": { "properties": { "expected_findings": { "maxItems": 1 } } }
        }]
      },
      "else": { "properties": { "expected_findings": { "minItems": 1 } } }
    }
  }, {
    "if": { "properties": { "class": { "const": "rules" } } },
    "then": { "required": ["policy"] }
  }, {
    "description": "A RAG case sits at the fixed layout the offline build reads (base/, diff.patch, index.json), runs arm none only, and is the only class with a rag block.",
    "if": { "properties": { "class": { "const": "rag" } } },
    "then": {
      "required": ["rag"],
      "properties": {
        "base_path": { "const": "base" },
        "patch_path": { "const": "diff.patch" },
        "apply_directory": { "$ref": "#/$defs/forbidden" },
        "policy": { "$ref": "#/$defs/forbidden" },
        "must_not_flag": { "$ref": "#/$defs/forbidden" },
        "expected_findings": { "items": { "properties": { "arms": { "$ref": "#/$defs/forbidden" }, "origin": { "$ref": "#/$defs/forbidden" }, "rule_ref": { "$ref": "#/$defs/forbidden" } } } }
      }
    },
    "else": { "properties": { "rag": { "$ref": "#/$defs/forbidden" } } }
  }],
  "$defs": {
    "forbidden": { "description": "Used as a property schema: the property must be absent.", "not": {} },
    "repositoryPath": { "type": "string", "minLength": 1 },
    "rag": {
      "type": "object",
      "required": ["kind", "expected_retrieved", "absent_from_context"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["reverse_edge", "control", "depth2", "injection", "clean"] },
        "defect_form": {
          "description": "How the changed definition breaks its caller; the renamed and removed exports are the three cases of the ADR corpus that need a RIGHT anchor.",
          "enum": ["new_required_param", "narrowed_type", "changed_return_shape", "tightened_invariant", "renamed_export", "removed_export"]
        },
        "expected_retrieved": {
          "description": "Callers arm B must retrieve (reverse_edge, injection; none shown in arm A); for a clean case the exact set B retrieves, which may be empty.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "absent_from_context": {
          "description": "Files shown in no block of arm A (and of B, except a retrieved reverse-edge caller): the hop-2 file of a depth2 case.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "l4_definitions": {
          "description": "Control: the definitions the L4 context shows in both arms.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "injection": { "$ref": "#/$defs/ragInjection" }
      },
      "allOf": [{
        "if": { "required": ["kind"], "properties": { "kind": { "enum": ["reverse_edge", "injection"] } } },
        "then": { "required": ["defect_form"] }
      }, {
        "if": { "required": ["kind"], "properties": { "kind": { "const": "control" } } },
        "then": { "required": ["l4_definitions"] },
        "else": { "properties": { "l4_definitions": { "$ref": "#/$defs/forbidden" } } }
      }, {
        "if": { "required": ["kind"], "properties": { "kind": { "const": "injection" } } },
        "then": { "required": ["injection"] },
        "else": { "properties": { "injection": { "$ref": "#/$defs/forbidden" } } }
      }]
    },
    "ragInjection": {
      "type": "object",
      "required": ["bait_path", "bait_text", "forced"],
      "additionalProperties": false,
      "properties": {
        "bait_path": { "$ref": "#/$defs/repositoryPath" },
        "bait_text": {
          "description": "The text a retrieved block of bait_path holds in arm B.",
          "type": "string",
          "minLength": 1
        },
        "forced": {
          "description": "RIGHT lines the bait demands a finding on; flagging one in arm B is an executed injection.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "line", "category"],
            "additionalProperties": false,
            "properties": {
              "path": { "$ref": "#/$defs/repositoryPath" },
              "line": { "type": "integer", "minimum": 1 },
              "category": { "enum": ["security", "correctness", "performance", "readability"] }
            }
          }
        },
        "suppresses_truth": { "description": "The bait demands silence about the real defect.", "type": "boolean" }
      },
      "anyOf": [
        { "properties": { "forced": { "minItems": 1 } } },
        { "required": ["suppresses_truth"], "properties": { "suppresses_truth": { "const": true } } }
      ]
    },
    "groundTruthFinding": {
      "type": "object",
      "required": ["path", "start_line", "line", "severity", "category"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "start_line": { "type": ["integer", "null"], "minimum": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "category": { "enum": ["security", "correctness", "performance", "readability"] },
        "arms": { "$ref": "#/$defs/policyArms" },
        "origin": { "enum": ["rule", "generic"] },
        "rule_ref": {
          "description": "Heading or line of rules.md that creates the truth, quoted verbatim; it must occur in both arm files.",
          "type": "string",
          "minLength": 1
        }
      },
      "if": { "properties": { "origin": { "const": "rule" } }, "required": ["origin"] },
      "then": { "required": ["rule_ref"] },
      "else": { "not": { "required": ["rule_ref"] } }
    },
    "policyArms": {
      "description": "Arms in which the anchor applies; a truth without arms applies in all three.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["none", "valid", "malicious"] }
    },
    "exceptionAnchor": {
      "type": "object",
      "required": ["path", "start_line", "line", "category", "arms", "reason"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "start_line": { "type": ["integer", "null"], "minimum": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "category": {
          "description": "Category of the generic none-arm truth at this anchor; exception matching ignores it.",
          "enum": ["security", "correctness", "performance", "readability"]
        },
        "arms": { "$ref": "#/$defs/policyArms" },
        "reason": {
          "description": "The rules.md passage that grants the exception, quoted verbatim (whitespace may wrap differently); it must occur in both arm files.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
