+from __future__ import annotations
+
+import sqlite3
+
+def list_orders(connection: sqlite3.Connection, account_id: str) -> list[tuple[int, int]]:
+    query = f"SELECT id, total_cents FROM orders WHERE account_id = '{account_id}'"
+    return connection.execute(query).fetchall()
