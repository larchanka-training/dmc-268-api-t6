+
 export function useTheme(): [Theme, (next: Theme) => void] {
-  const [theme, setTheme] = useState<Theme>("light");
+  const [theme, setTheme] = useState<Theme>(loadTheme);
 
   useEffect(() => {
     document.documentElement.dataset.theme = theme;
+    saveTheme(theme);
   }, [theme]);
 
   return [theme, setTheme];
