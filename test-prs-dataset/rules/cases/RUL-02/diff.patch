+++ b/src/components/MemberChips.tsx
@@ -0,0 +1,26 @@
+import type { Member } from "../hooks/useTeam";
+import { CloseIcon } from "./icons/CloseIcon";
+
+type Props = {
+  members: Member[];
+  onRemove: (memberId: string) => void;
+};
+
+export function MemberChips({ members, onRemove }: Props) {
+  return (
+    <ul className="member-chips">
+      {members.map((member) => (
+        <li>
+          <span>{member.login}</span>
+          <button
+            type="button"
+            aria-label={`Remove ${member.login}`}
+            onClick={() => onRemove(member.id)}
+          >
+            <CloseIcon />
+          </button>
+        </li>
+      ))}
+    </ul>
+  );
+}
