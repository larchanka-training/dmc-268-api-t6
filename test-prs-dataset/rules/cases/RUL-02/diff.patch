@@ -0,0 +1,37 @@
+import { useState } from "react";
+
+import { t } from "../i18n";
+
+type Props = {
+  projectName: string;
+  members: string[];
+  onDelete: () => Promise<void>;
+};
+
+export function ProjectDangerZone({ projectName, members, onDelete }: Props) {
+  const [busy, setBusy] = useState(false);
+
+  async function handleDelete() {
+    setBusy(true);
+    try {
+      await onDelete();
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <section aria-labelledby="danger-zone-title">
+      <h2 id="danger-zone-title">{t("project.dangerZone.title")}</h2>
+      <p>{t("project.dangerZone.description", { name: projectName })}</p>
+      <ul>
+        {members.map((member) => (
+          <li>{member}</li>
+        ))}
+      </ul>
+      <button type="button" disabled={busy} onClick={handleDelete}>
+        Delete project
+      </button>
+    </section>
+  );
+}
