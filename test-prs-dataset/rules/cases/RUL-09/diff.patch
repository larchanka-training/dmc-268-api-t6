+import type { Invite } from "./types";
+
+const DATE_FORMAT = new Intl.DateTimeFormat("en", { dateStyle: "medium" });
+
+/** Shows the newest invite: who sent it and the note they typed for the recipient. */
+export function renderOrgInvite(container: HTMLElement, invites: Invite[]): void {
+  const sorted = [...invites].sort((a, b) => a.sentAt.localeCompare(b.sentAt));
+  const newest = sorted[sorted.length];
+  const sent = DATE_FORMAT.format(new Date(newest.sentAt));
+
+  container.innerHTML = `<p>${newest.sender}, ${sent}</p><p>${newest.note}</p>`;
+}
