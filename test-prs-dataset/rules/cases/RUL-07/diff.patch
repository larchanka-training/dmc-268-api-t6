diff --git a/app/telemetry/usage_events.py b/app/telemetry/usage_events.py
index 3623a37..3a935d2 100644
--- a/app/telemetry/usage_events.py
+++ b/app/telemetry/usage_events.py
@@ -14,3 +14,18 @@ class Event:
 
 def encode(event: Event) -> str:
     return json.dumps(asdict(event), sort_keys=True)
+
+
+def spool(event: Event, path: str) -> None:
+    """Append the event to the local spool file that the uploader drains."""
+    try:
+        with open(path, "a", encoding="utf-8") as handle:
+            handle.write(encode(event) + "\n")
+    except Exception:
+        pass
+
+
+def pending_events(path: str) -> list[str]:
+    """Spooled events that the uploader has not sent yet."""
+    handle = open(path, encoding="utf-8")
+    return handle.read().splitlines()
