+import { cartTotal, invoiceTotal, recalculateLater, type Line } from "../total";
 
 describe("cartTotal", () => {
   test("adds tax to the subtotal", () => {
     const items: Line[] = [
       { sku: "book", price: 10, quantity: 2 },
       { sku: "pen", price: 1.5, quantity: 4 },
     ];
 
     expect(cartTotal(items)).toBe(31.2);
   });
 });
+
+describe("invoiceTotal", () => {
+  test("matches the cart total", () => {
+    const items: Line[] = [
+      { sku: "book", price: 10, quantity: 2 },
+      { sku: "pen", price: 1.5, quantity: 4 },
+    ];
+
+    expect(invoiceTotal(items)).toBe(cartTotal(items));
+  });
+});
+
+describe("recalculateLater", () => {
+  test("reports the total after the delay", async () => {
+    const onTotal = vi.fn();
+
+    recalculateLater([], onTotal);
+    await new Promise((resolve) => setTimeout(resolve, 150));
+
+    expect(onTotal).toHaveBeenCalledWith(0);
+  });
+});
