+"""Recorded GitHub API answers replayed by the webhook tests."""
+
+import pickle
+from pathlib import Path
+
+RECORDINGS = Path(__file__).with_name("github_responses.pickle")
+
+
+def recorded_responses() -> dict[str, object]:
+    with RECORDINGS.open("rb") as handle:
+        return pickle.load(handle)
