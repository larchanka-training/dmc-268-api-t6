+"""Lookup of password reset tokens."""
+
+from __future__ import annotations
+
+import sqlite3
+from datetime import UTC, datetime
+
+
+def find_valid_token(db: sqlite3.Connection, token: str) -> int | None:
+    """Return the user of an unexpired reset token."""
+    now = datetime.now(UTC).isoformat()
+    row = db.execute(
+        f"SELECT user_id FROM reset_tokens WHERE token = '{token}' AND expires_at > ?",
+        (now,),
+    ).fetchone()
+    return None if row is None else int(row[0])
