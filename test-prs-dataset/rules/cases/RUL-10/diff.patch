+"""Search endpoint of the reports service."""
+
+from fastapi import APIRouter, Depends
+
+from app.db import Connection, get_connection
+from app.reports.queries import report_by_title
+
+router = APIRouter()
+
+
+@router.get("/reports/by-title")
+async def get_report_by_title(title: str, conn: Connection = Depends(get_connection)) -> dict:
+    return await report_by_title(conn, title)
