@@ -0,0 +1,15 @@
+"""Recompute the missing totals of one table."""
+
+import asyncio
+import sys
+
+from app.db import connect
+
+
+async def rebuild(table: str) -> None:
+    conn = await connect()
+    await conn.execute(f"UPDATE {table} SET total = subtotal + tax WHERE total IS NULL")
+
+
+if __name__ == "__main__":
+    asyncio.run(rebuild(sys.argv[1]))
