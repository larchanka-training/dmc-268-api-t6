index 0000000..cf39712
--- /dev/null
+++ b/app/api/invoices.py
@@ -0,0 +1,31 @@
+"""Invoice endpoints of the billing API."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter, Depends
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.api.deps import current_customer
+from app.db.models import Customer, Invoice
+from app.db.session import get_session
+from app.services.invoices import InvoiceSummary
+
+router = APIRouter(prefix="/me/invoices", tags=["invoices"])
+
+
+@router.get("")
+async def list_my_invoices(
+    customer: Customer = Depends(current_customer),
+    session: AsyncSession = Depends(get_session),
+) -> list[InvoiceSummary]:
+    result = await session.execute(
+        select(Invoice)
+        .where(Invoice.customer_id == customer.id)
+        .order_by(Invoice.issued_at.desc())
+        .limit(50)
+    )
+    return [
+        InvoiceSummary(number=row.number, total_cents=row.total_cents, status=row.status)
+        for row in result.scalars()
+    ]
