#cloud-config
package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - gnupg
  - jq
  - fail2ban
  - nftables
  - python3-systemd

write_files:
  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "log-driver": "json-file",
        "log-opts": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
  # Debian 12 starts sshd from ssh.service (ssh.socket is disabled), so a restart applies the port.
  # The deploy user is root with a key (STAGING_SSH_USER), hence prohibit-password rather than no.
  - path: /etc/ssh/sshd_config.d/10-dmc-268.conf
    permissions: "0644"
    content: |
      Port ${ssh_port}
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password
  # Debian 12 has no /var/log/auth.log without rsyslog: read sshd logs from the journal.
  - path: /etc/fail2ban/jail.d/sshd.local
    permissions: "0644"
    content: |
      [sshd]
      enabled = true
      port = ${ssh_port}
      backend = systemd
      banaction = nftables-multiport

runcmd:
  - /usr/sbin/sshd -t && systemctl restart ssh
  - fail2ban-client -t && systemctl enable fail2ban && systemctl restart fail2ban
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  - chmod a+r /etc/apt/keyrings/docker.gpg
  - echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - mkdir -p ${app_dir}
  - systemctl enable --now docker
  - until docker info >/dev/null 2>&1; do sleep 1; done
  - docker pull ${bootstrap_image}
  - docker run -d --name ${bootstrap_name} --restart unless-stopped --label dmc-268.role=bootstrap -p 80:80 ${bootstrap_image}
