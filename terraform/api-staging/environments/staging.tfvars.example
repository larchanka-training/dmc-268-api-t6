environment        = "staging"
location           = "nbg1"
network_zone       = "eu-central"
server_type        = "cx22"
ssh_public_key     = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIreplace-with-ci-public-key ci@dmc-268"
# ssh_operator_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIreplace-with-operator-key operator@dmc-268"
# SSH is world-open by design (GitHub-hosted runners have no stable egress IPs):
# key-only auth, fail2ban and a non-standard port. Defaults shown.
# ssh_allowed_cidrs = ["0.0.0.0/0", "::/0"]
# ssh_port          = 22022
container_registry = "ghcr.io"
image_repository   = "larchanka-training/dmc-268-api-t6"
bootstrap_image    = "nginx:1.27-alpine"

# Hetzner Cloud DNS. Leave dns_zone empty to skip records.
# After apply, delegate the domain to output dns_nameservers.
# dns_zone         = "example.com"
# create_dns_zone  = true
# dns_record_name  = "api-staging"
# dns_ttl          = 300
