+++ b/app/modules/billing/infrastructure/repository.py
@@ -0,0 +1,33 @@
+"""Charge repository backed by the billing database."""
+
+from __future__ import annotations
+
+from uuid import UUID
+
+from sqlalchemy import select
+
+from app.modules.billing.infrastructure.models import ChargeRow
+
+
+class ChargeRepository:
+    """Persists and reads charge records for an account."""
+
+    def __init__(self, session) -> None:
+        self._session = session
+
+    async def save(self, request, gateway_reference: str) -> UUID:
+        row = ChargeRow(
+            account_id=request.account_id,
+            amount=request.amount,
+            currency=request.currency,
+            gateway_reference=gateway_reference,
+        )
+        self._session.add(row)
+        await self._session.flush()
+        return row.id
+
+    async def get_latest(self, account_id: UUID) -> ChargeRow | None:
+        """Return the latest charge recorded for the account, if any."""
+        stmt = select(ChargeRow).where(ChargeRow.account_id == account_id)
+        result = await self._session.execute(stmt)
+        return result.scalars().first()
