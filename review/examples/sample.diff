@@ -0,0 +1,62 @@
+"""Tests for the ChargeAccount use case."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from decimal import Decimal
+from uuid import UUID, uuid4
+
+import pytest
+
+from app.modules.billing.application.charge import ChargeAccount, ChargeRequest
+
+
+@dataclass
+class FakeReceipt:
+    reference: str
+
+
+class FakeGateway:
+    def __init__(self, receipt: FakeReceipt | None = None, fails: bool = False) -> None:
+        self._receipt = receipt
+        self._fails = fails
+
+    async def charge(self, account_id: UUID, amount: Decimal, currency: str) -> FakeReceipt:
+        if self._fails:
+            raise RuntimeError("gateway unavailable")
+        return self._receipt
+
+
+class FakeRepository:
+    def __init__(self) -> None:
+        self.saved = []
+
+    async def save(self, request: ChargeRequest, gateway_reference: str) -> UUID:
+        charge_id = uuid4()
+        self.saved.append((charge_id, request, gateway_reference))
+        return charge_id
+
+
+@pytest.mark.asyncio
+async def test_execute_saves_charge_on_success() -> None:
+    gateway = FakeGateway(receipt=FakeReceipt(reference="ref-1"))
+    repository = FakeRepository()
+    use_case = ChargeAccount(gateway=gateway, repository=repository)
+    request = ChargeRequest(account_id=uuid4(), amount=Decimal("10.00"), currency="USD")
+
+    charge_id = await use_case.execute(request)
+
+    assert charge_id is not None
+    assert repository.saved[0][2] == "ref-1"
+
+
+@pytest.mark.asyncio
+async def test_execute_returns_none_when_gateway_fails() -> None:
+    gateway = FakeGateway(fails=True)
+    repository = FakeRepository()
+    use_case = ChargeAccount(gateway=gateway, repository=repository)
+    request = ChargeRequest(account_id=uuid4(), amount=Decimal("5.00"), currency="USD")
+
+    charge_id = await use_case.execute(request)
+
+    assert charge_id is None
