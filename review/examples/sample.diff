+"""Charge application use case."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from decimal import Decimal
+from uuid import UUID
+
+
+@dataclass(frozen=True)
+class ChargeRequest:
+    account_id: UUID
+    amount: Decimal
+    currency: str
+
+
+class ChargeAccount:
+    """Charges an account through the configured payment gateway."""
+
+    def __init__(self, gateway, repository) -> None:
+        self._gateway = gateway
+        self._repository = repository
+
+    async def execute(self, request: ChargeRequest) -> UUID | None:
+        try:
+            receipt = await self._gateway.charge(
+                account_id=request.account_id,
+                amount=request.amount,
+                currency=request.currency,
+            )
+        except Exception:
+            return None
+
+        charge_id = await self._repository.save(request, receipt.reference)
+        return charge_id
diff --git a/app/modules/billing/infrastructure/repository.py b/app/modules/billing/infrastructure/repository.py
